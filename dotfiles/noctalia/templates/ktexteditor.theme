{
  "metadata": {
    "copyright": [
      "SPDX-FileCopyrightText: 2016 Volker Krause <vkrause@kde.org>",
      "SPDX-FileCopyrightText: 2016 Dominik Haumann <dhaumann@kde.org>"
    ],
    "license": "SPDX-License-Identifier: MIT",
    "revision": 1,
    "name": "Noctalia"
  },
  "text-styles": {
    "Normal": {
      "text-color": "{{ colors.on_surface.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}",
      "bold": false,
      "italic": false,
      "underline": false,
      "strike-through": false
    },
    "Keyword": {
      "text-color": "{{ colors.primary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}",
      "bold": true
    },
    "Function": {
      "text-color": "{{ colors.tertiary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}"
    },
    "Variable": {
      "text-color": "{{ colors.secondary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}"
    },
    "ControlFlow": {
      "text-color": "{{ colors.primary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}",
      "bold": true
    },
    "Operator": {
      "text-color": "{{ colors.on_surface_variant.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}"
    },
    "BuiltIn": {
      "text-color": "{{ colors.tertiary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}",
      "bold": true
    },
    "Extension": {
      "text-color": "{{ colors.secondary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}",
      "bold": true
    },
    "Preprocessor": {
      "text-color": "{{ colors.secondary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}"
    },
    "Attribute": {
      "text-color": "{{ colors.secondary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}"
    },
    "Char": {
      "text-color": "{{ colors.tertiary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}"
    },
    "SpecialChar": {
      "text-color": "{{ colors.secondary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}"
    },
    "String": {
      "text-color": "{{ colors.tertiary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}"
    },
    "VerbatimString": {
      "text-color": "{{ colors.tertiary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}"
    },
    "SpecialString": {
      "text-color": "{{ colors.primary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}"
    },
    "Import": {
      "text-color": "{{ colors.secondary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}"
    },
    "DataType": {
      "text-color": "{{ colors.secondary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}"
    },
    "DecVal": {
      "text-color": "{{ colors.tertiary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}"
    },
    "BaseN": {
      "text-color": "{{ colors.tertiary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}"
    },
    "Float": {
      "text-color": "{{ colors.tertiary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}"
    },
    "Constant": {
      "text-color": "{{ colors.primary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}"
    },
    "Comment": {
      "text-color": "{{ colors.on_surface_variant.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}"
    },
    "Documentation": {
      "text-color": "{{ colors.on_surface_variant.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}"
    },
    "Annotation": {
      "text-color": "{{ colors.tertiary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}"
    },
    "CommentVar": {
      "text-color": "{{ colors.secondary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}"
    },
    "RegionMarker": {
      "text-color": "{{ colors.primary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}",
      "background-color": "{{ colors.tertiary_container.default.hex }}"
    },
    "Information": {
      "text-color": "{{ colors.secondary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}"
    },
    "Warning": {
      "text-color": "{{ colors.tertiary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}"
    },
    "Alert": {
      "text-color": "{{ colors.error.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}",
      "background-color": "{{ colors.error_container.default.hex }}",
      "bold": true
    },
    "Error": {
      "text-color": "{{ colors.error.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}",
      "underline": true
    },
    "Others": {
      "text-color": "{{ colors.secondary.default.hex }}",
      "selected-text-color": "{{ colors.on_primary_container.default.hex }}"
    }
  },
  "editor-colors": {
    "BackgroundColor": "{{ colors.surface.default.hex }}",
    "CodeFolding": "{{ colors.primary.default.hex }}",
    "BracketMatching": "{{ colors.tertiary_container.default.hex }}",
    "CurrentLine": "{{ colors.surface_container_low.default.hex }}",
    "IconBorder": "{{ colors.surface.default.hex }}",
    "IndentationLine": "{{ colors.outline_variant.default.hex }}",
    "LineNumbers": "{{ colors.on_surface_variant.default.hex }}",
    "CurrentLineNumber": "{{ colors.on_surface.default.hex }}",
    "MarkBookmark": "{{ colors.primary.default.hex }}",
    "MarkBreakpointActive": "{{ colors.error.default.hex }}",
    "MarkBreakpointReached": "{{ colors.tertiary.default.hex }}",
    "MarkBreakpointDisabled": "{{ colors.secondary.default.hex }}",
    "MarkExecution": "{{ colors.tertiary.default.hex }}",
    "MarkWarning": "{{ colors.tertiary.default.hex }}",
    "MarkError": "{{ colors.error.default.hex }}",
    "ModifiedLines": "{{ colors.primary.default.hex }}",
    "ReplaceHighlight": "{{ colors.tertiary_container.default.hex }}",
    "SavedLines": "{{ colors.secondary.default.hex }}",
    "SearchHighlight": "{{ colors.tertiary_container.default.hex }}",
    "TextSelection": "{{ colors.primary_container.default.hex }}",
    "Separator": "{{ colors.outline_variant.default.hex }}",
    "SpellChecking": "{{ colors.error.default.hex }}",
    "TabMarker": "{{ colors.outline_variant.default.hex }}",
    "TemplateBackground": "{{ colors.surface_container.default.hex }}",
    "TemplatePlaceholder": "{{ colors.secondary_container.default.hex }}",
    "TemplateFocusedPlaceholder": "{{ colors.primary_container.default.hex }}",
    "TemplateReadOnlyPlaceholder": "{{ colors.surface_container_low.default.hex }}",
    "WordWrapMarker": "{{ colors.outline_variant.default.hex }}"
  },
  "_comments": [
    "Derived from KDE Breeze Light; Noctalia renders its active palette into this theme."
  ]
}
