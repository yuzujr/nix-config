#!/usr/bin/env bash

# Select Delta's palette from the Kitty theme generated by Noctalia. This is
# reliable inside TUI applications such as LazyGit, where Delta cannot query
# the terminal background directly.

theme_file="${XDG_CONFIG_HOME:-$HOME/.config}/kitty/themes/noctalia.conf"
background=""

if [[ -r "$theme_file" ]]; then
    while read -r key value _; do
        if [[ "$key" == "background" ]]; then
            background="$value"
            break
        fi
    done <"$theme_file"
fi

hex="${background#\#}"
if [[ "$hex" =~ ^[[:xdigit:]]{6}$ ]]; then
    red=$((16#${hex:0:2}))
    green=$((16#${hex:2:2}))
    blue=$((16#${hex:4:2}))

    # Integer approximation of perceived brightness (Rec. 601 luma).
    if ((299 * red + 587 * green + 114 * blue >= 128000)); then
        exec delta --light "$@"
    else
        exec delta --dark "$@"
    fi
fi

# Preserve Delta's native detection outside Kitty or before theme generation.
exec delta "$@"
